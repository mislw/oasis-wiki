    {
      "component_id": "button.purchase.primary",
      "category": "button",
      "parent_id": "background.special_offer.scene",
      "layer": 60,
      "z_index": 10,
      "bounds": {"x": 900, "y": 590, "width": 220, "height": 64},
      "status": "pending_review",
      "asset_policy": "native",
