    "operations": [
      {"operation_id": "purchase.offer", "trigger": "button.purchase", "action": "request_purchase", "owner": "server"}
    ]
  },
  "visual": {
    "profile": "redcliff",
    "reference_images": [
      {
        "source": "<original-style-image-path>",
        "role": "style",
        "priority": 1,
        "copy_visual_style": true,
        "source_kind": "input_image_attachment"
      },
      {
        "source": "<original-layout-image-path>",
        "role": "layout",
        "priority": 1,
        "copy_visual_style": false,
        "source_kind": "input_image_attachment"
      }
